# Generate your own value; never commit .env.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=UTC
DATABASE_NAME=mock_exam
DATABASE_USER=mock_exam
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSLMODE=prefer
# Optional; comma-separated full origins, including scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_HTTPS=False
DJANGO_SECURE_HSTS_SECONDS=0
# Optional absolute paths; defaults are staticfiles/ and .import-staging/.
# DJANGO_STATIC_ROOT=
# IMPORT_STAGING_ROOT=

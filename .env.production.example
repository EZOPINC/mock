# Copy to .env on the production host only; fill secrets and real hostnames.
DJANGO_ENV=prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=exam.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://exam.example.com
DJANGO_TIME_ZONE=UTC
DATABASE_NAME=mock_exam
DATABASE_USER=mock_exam
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Choose require/verify-full if your PostgreSQL server uses TLS.
DATABASE_SSLMODE=prefer
DJANGO_SECURE_SSL_REDIRECT=True
# True ONLY if your trusted HTTPS proxy strips/sets X-Forwarded-Proto itself.
DJANGO_TRUST_PROXY_HTTPS=False
# Enable after confirming HTTPS works; increase later as appropriate.
DJANGO_SECURE_HSTS_SECONDS=0
# Optional absolute writable paths, outside the public web root for staging.
# DJANGO_STATIC_ROOT=/path/to/staticfiles
# IMPORT_STAGING_ROOT=/private/path/to/import-staging

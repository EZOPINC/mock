# Production-local Git ignore reference for the Mock Exam Platform.
# Copy to .gitignore if desired; it protects UNTRACKED files only.
# IMPORTANT: tracked tests still arrive through git clone/pull even when ignored.
# Exclude tracked tests through your deployment packaging or Git sparse-checkout.
# Keep tests tracked in the shared development repository; do not git rm --cached
# them merely to change a production deployment.
# Keep Django migrations, runtime source, templates and source static assets.

# Python environment and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]

# Local configuration; retain sanitized reference configurations.
.env
.env.*
!.env.example
!.env.production.example

# Runtime/collected output and compiler caches.
staticfiles/
.import-staging/
.tools/
logs/
*.log
*.pid
*.sock

# Private keys and server-local secrets.
*.pem
*.key
secrets/

# Python tests at any directory depth.
tests.py
test_*.py
*_test.py
conftest.py
tests/
test/

# Project-specific opt-in browser tests and their helper.
/tools/verify_exam_ui.py
/tools/exam_browser.py

# Test-runner caches and generated reports.
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
test-results/
playwright-report/
/docs/screenshots/

# Local agent instructions/production ignore file (does not untrack either).
AGENTS.md
.gitignore
